# ---------------------------------------------------------------------------
# Moustiq'Air — environment configuration
# Copy this file to `.env` and change every secret before using real data.
# ---------------------------------------------------------------------------

# SQLite database file. Relative paths are resolved from the project root.
DATABASE_PATH=./data/moustiquair.db

# Teacher password hash. NEVER put the plain password here.
# Generate a new hash with: bun run admin:hash
# The hash below corresponds to the development password "MoustiqAir2026!".
# Change it before deploying the application.
# Format: scrypt:N:r:p:salt:hash — colons avoid .env "$" expansion.
ADMIN_PASSWORD_HASH="scrypt:32768:8:1:X2WVDomGIa1AqZAkxfKROg==:CYefsQCsKq8Ldf5lqpzOqnBvHl64gWAfhBW5mKgU31uSUqRZ4uv0+AffNM6w49O+MRrHLOpERNjNTTHZXIUYyA=="

# Random secret used to sign/derive session identifiers and audit values.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in hours.
SESSION_TTL_HOURS=12
