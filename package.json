{
  "name": "moustiquair",
  "version": "1.0.0",
  "private": true,
  "description": "Moustiq'Air — cartographie citoyenne de l'activité du moustique tigre à Herblay-sur-Seine",
  "scripts": {
    "dev": "bun run scripts/copy-maplibre-worker.ts && bun run db:migrate && bun --bun next dev",
    "build": "bun run scripts/copy-maplibre-worker.ts && bun --bun next build",
    "start": "bun --bun next start",
    "prepare:worker": "bun run scripts/copy-maplibre-worker.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed-demo.ts",
    "db:reset-demo": "bun scripts/seed-demo.ts",
    "admin:hash": "bun scripts/hash-password.ts",
    "boundary:fetch": "bun scripts/fetch-boundary.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "proj4": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3"
  }
}
