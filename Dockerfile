# Moustiq'Air production image
#
# Build stages are ordered from the least to the most frequently changing
# layers so that Docker can reuse the Bun install and Next.js build caches.
# The final image contains only the standalone Next.js output, the SQLite
# migrations and a small migration bundle; it does not ship dev dependencies.

FROM oven/bun:1.4.4-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Dependencies (cached as long as package.json and bun.lock do not change)
# ---------------------------------------------------------------------------
FROM base AS deps
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM deps AS builder
COPY . .
# The MapLibre worker is generated by the build script. The Bun cache mount
# keeps Next.js compilation fast between deployments.
RUN --mount=type=cache,target=/app/.next/cache \
    bun run build

# Compile the migration runner into one small file. `bun:sqlite` is a Bun
# built-in and stays external. The SQL files remain in /app/drizzle.
RUN bun build scripts/migrate.ts --target=bun --outfile=dist/migrate.js

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    DATABASE_PATH=/data/moustiquair.db

# The `bun` user (uid 1000) already exists in the official image. The
# entrypoint gives it ownership of the named volume, then drops root.
RUN mkdir -p /data \
    && chown bun:bun /data

COPY --from=builder --chown=bun:bun /app/.next/standalone ./
COPY --from=builder --chown=bun:bun /app/.next/static ./.next/static
COPY --from=builder --chown=bun:bun /app/public ./public
COPY --from=builder --chown=bun:bun /app/drizzle ./drizzle
COPY --from=builder --chown=bun:bun /app/dist/migrate.js ./scripts/migrate.js
COPY --chown=bun:bun docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 755 /usr/local/bin/docker-entrypoint.sh \
    && chown -R bun:bun /app

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Apply pending migrations before starting, so a fresh volume gets the schema.
CMD ["sh", "-c", "bun scripts/migrate.js && exec bun server.js"]
